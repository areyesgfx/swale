locals {
  db_name  = replace(var.name, "-", "_")
  username = "app"
}

resource "aws_db_subnet_group" "this" {
  name_prefix = "${var.name}-"
  subnet_ids  = var.private_subnet_ids

  tags = { Name = var.name }
}

# No inbound rules here: the service module adds one for the app's
# containers. It's the side that knows their security group, and adding
# the rule here instead would make the two units depend on each other.
resource "aws_security_group" "this" {
  name_prefix = "${var.name}-db-"
  description = "The app's database: inbound only from the app's containers."
  vpc_id      = var.vpc_id

  tags = { Name = "${var.name}-db" }

  lifecycle {
    create_before_destroy = true
  }
}

# The master password is generated by Secrets Manager and only ever passed
# through write-only arguments, so it's never stored in Terraform state.
# It changes only when password_version does. That's deliberate: a
# password rotated on a schedule (what RDS-managed passwords do every 7
# days) would leave running containers, which read it once at start, with
# a stale one.
ephemeral "aws_secretsmanager_random_password" "master" {
  password_length     = 32
  exclude_punctuation = true
}

resource "aws_secretsmanager_secret" "master" {
  name_prefix = "${var.name}-db-"
  description = "Master user credentials for the ${var.name} database."
}

resource "aws_secretsmanager_secret_version" "master" {
  secret_id = aws_secretsmanager_secret.master.id
  secret_string_wo = jsonencode({
    username = local.username
    password = ephemeral.aws_secretsmanager_random_password.master.random_password
  })
  secret_string_wo_version = var.password_version
}

# RDS for PostgreSQL 15 and later rejects unencrypted connections by
# default (rds.force_ssl = 1), so there's no parameter group to manage.
resource "aws_db_instance" "this" {
  identifier                 = var.name
  engine                     = "postgres"
  engine_version             = "17"
  auto_minor_version_upgrade = true
  instance_class             = var.instance_class

  allocated_storage     = 20
  max_allocated_storage = 100
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name             = local.db_name
  username            = local.username
  password_wo         = ephemeral.aws_secretsmanager_random_password.master.random_password
  password_wo_version = var.password_version

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.this.id]
  publicly_accessible    = false
  multi_az               = var.highly_available

  deletion_protection       = var.deletion_protection
  backup_retention_period   = var.backup_retention_days
  copy_tags_to_snapshot     = true
  skip_final_snapshot       = false
  final_snapshot_identifier = "${var.name}-final"
}
