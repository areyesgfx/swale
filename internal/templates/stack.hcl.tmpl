unit "networking" {
  source = "../../units/networking"
  path   = "networking"
  values = {
    name     = "{{ .ResourceName }}"
    vpc_cidr = "{{ .VPCCIDR }}"
    nat_mode = "{{ .NATMode }}"
  }
}
{{- with .Service }}

unit "service" {
  source = "../../units/service"
  path   = "service"
  values = {
    name          = "{{ $.ResourceName }}"
    image_tag     = "v1"
    desired_count = {{ .DesiredCount }}
{{- if .Port }}

    port              = {{ .Port }}
    health_check_path = "{{ .HealthCheckPath }}"
{{- end }}
  }
}
{{- end }}
