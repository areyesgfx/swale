# Generated by swale. swale never overwrites this file once it exists, so
# it's yours to edit.

terragrunt_version_constraint = ">= 1.1.0"

locals {
  # path_relative_to_include() bakes a ".terragrunt-stack/<unit>" segment
  # into the path when a unit is materialized via `terragrunt stack
  # generate`, e.g. "live/<account>/<env>/.terragrunt-stack/<unit>". Strip
  # it so the state key reflects the logical account/env/component path,
  # not stacks' disposable build-artifact layout. This is a no-op for units
  # that aren't stack-materialized, since the segment is simply absent.
  state_key = replace(path_relative_to_include(), ".terragrunt-stack/", "")
}

# Terragrunt creates this bucket itself when run with --backend-bootstrap,
# which avoids the chicken-and-egg problem of needing a state backend
# before Terraform can create one.
remote_state {
  backend = "s3"

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }

  config = {
    bucket  = "{{ .StateBucket }}"
    key     = "${local.state_key}/terraform.tfstate"
    region  = "{{ .Region }}"
    encrypt = true

    # S3 native locking (conditional writes) instead of a DynamoDB lock
    # table - one less resource to provision, pay for, and keep in sync
    # with the state bucket.
    use_lockfile = true
  }
}

generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<-EOF
    provider "aws" {
      region = "{{ .Region }}"

      default_tags {
        tags = {
          ManagedBy = "swale"
{{- range $key, $value := .Tags }}
          {{ $key }} = "{{ $value }}"
{{- end }}
        }
      }
    }
  EOF
}
