# Generated by swale. Per docs/adr/0001-generate-with-text-template.md,
# swale renders this file once and never rewrites it, so it's yours to
# edit after generation.

terragrunt_version_constraint = ">= 1.1.0"

locals {
  # path_relative_to_include() bakes a ".terragrunt-stack/<unit>" segment
  # into the path when a unit is materialized via `terragrunt stack
  # generate` (ADR 0005), e.g. "live/<account>/<env>/.terragrunt-stack/<unit>".
  # Strip it so the state key reflects the logical account/env/component
  # path, not stacks' disposable build-artifact layout. This is a no-op for
  # units that aren't stack-materialized, since the segment is simply absent.
  state_key = replace(path_relative_to_include(), ".terragrunt-stack/", "")
}

# Terragrunt creates this bucket itself on first use (ADR 0004): a separate
# bootstrap step to create the state backend before Terragrunt can use it
# would be a chicken-and-egg problem.
remote_state {
  backend = "s3"

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }

  config = {
    bucket  = "{{ .StateBucket }}"
    key     = "${local.state_key}/terraform.tfstate"
    region  = "{{ .Region }}"
    encrypt = true

    # S3 native locking (conditional writes) instead of a DynamoDB lock
    # table - one less resource to provision, pay for, and keep in sync
    # with the state bucket.
    use_lockfile = true
  }
}

generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<-EOF
    provider "aws" {
      region = "{{ .Region }}"

      default_tags {
        tags = {
          ManagedBy = "swale"
{{- range $key, $value := .Tags }}
          {{ $key }} = "{{ $value }}"
{{- end }}
        }
      }
    }
  EOF
}
